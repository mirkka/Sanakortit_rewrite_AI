{
  "name": "sanakortit-server",
  "version": "1.0.0",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "synth:local": "cdk synth SanakortitStack --quiet -c localDynamoEndpoint=http://dynamodb-local:8000",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "watch:synth": "nodemon --watch src --ext ts,graphql --exec 'npm run synth:local && sam local start-api -t cdk.out/SanakortitStack.template.json --port 4000 --docker-network sanakortit-local'",
    "setup:local-db": "ts-node scripts/setup-local-db.ts",
    "start:local": "docker compose up -d && npm run setup:local-db && npm run watch:synth"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@aws-sdk/client-dynamodb": "^3.1076.0",
    "@aws-sdk/lib-dynamodb": "^3.1076.0",
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "cors": "^2.0.0",
    "express": "^4.0.0",
    "graphql": "^16.0.0",
    "serverless-http": "^3.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@types/aws-lambda": "^8.0.0",
    "@types/cors": "^2.0.0",
    "@types/express": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.0.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
